# Copie este arquivo para `.env.local` e preencha com os dados do SEU projeto
# Supabase (Project Settings -> API). Sem eles o app roda em modo local:
# sem login, com os dados guardados apenas no navegador.
#
# Estes valores nao sao segredo — a chave anon/publishable e feita para rodar
# no navegador. Quem protege os dados e o RLS (ver docs/supabase-setup.sql).

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
